<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Concert+One&family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&display=swap" rel="stylesheet">
    <title>{{ title }}</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <header>
        {% include "nav.html" %}
    </header>
    {% if title=="Home" %}
        <div class="hero">
            <h2>Living a Zen Life</h2>
            <h3>A Guide</h3>
            <img src="/img/fuzzy.jpg">
        </div>
    {% endif %}
    
    <div class="wrapper">
        {% if title!="Home" %}
            <h1>{{ title }}</h1>
        {% endif %}
        {{ content | safe }}
    </div>
    <footer>
    </footer>
</body>
</html>